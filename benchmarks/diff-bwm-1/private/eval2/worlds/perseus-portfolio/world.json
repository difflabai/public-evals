{
  "schema": "bwm-coupled-world/1",
  "id": "perseus-portfolio",
  "name": "Perseus Portfolio \u2014 large-scale",
  "horizon": 6,
  "interface": "consistent",
  "units": [
    {
      "id": "mirfak-cloud",
      "name": "Mirfak Cloud (compounder)",
      "base_model": "sprout-crm",
      "customers_per_head": "48",
      "overrides": {
        "churn_rate": "0.03",
        "acv": "560",
        "conversion_rate": "0.05",
        "cost_per_lead": "20",
        "gm_rate": "0.86",
        "fixed_opex": "42000",
        "salary_per_head": "21000",
        "marketing_spend": "48000",
        "hires_per_quarter": "1",
        "customers_initial": "240",
        "headcount_initial": "11",
        "cash_initial": "380000"
      }
    },
    {
      "id": "algol-systems",
      "name": "Algol Systems (cash-cow)",
      "base_model": "sprout-crm",
      "customers_per_head": "34",
      "overrides": {
        "churn_rate": "0.18",
        "acv": "1600",
        "conversion_rate": "0.04",
        "cost_per_lead": "32",
        "gm_rate": "0.72",
        "fixed_opex": "70000",
        "salary_per_head": "24000",
        "marketing_spend": "52000",
        "hires_per_quarter": "1",
        "customers_initial": "175",
        "headcount_initial": "13",
        "cash_initial": "360000"
      }
    },
    {
      "id": "atik-data",
      "name": "Atik Data (secondary)",
      "base_model": "sprout-crm",
      "customers_per_head": "40",
      "overrides": {
        "churn_rate": "0.08",
        "acv": "900",
        "conversion_rate": "0.045",
        "cost_per_lead": "26",
        "gm_rate": "0.80",
        "fixed_opex": "52000",
        "salary_per_head": "22000",
        "marketing_spend": "50000",
        "hires_per_quarter": "1",
        "customers_initial": "210",
        "headcount_initial": "12",
        "cash_initial": "360000"
      }
    }
  ],
  "pools": [
    {
      "id": "growth_capital",
      "label": "Growth capital",
      "unit": "usd/quarter",
      "feeds_lever": "marketing_spend",
      "marginal_return_lever": true,
      "cap": [
        "260000",
        "260000",
        "260000",
        "260000",
        "260000",
        "260000"
      ]
    },
    {
      "id": "eng_headcount",
      "label": "Engineering headcount",
      "unit": "people/quarter (net hires)",
      "feeds_lever": "hires_per_quarter",
      "cap": [
        "8",
        "8",
        "8",
        "8",
        "8",
        "8"
      ]
    }
  ],
  "goal": {
    "metric": "revenue",
    "target_multiple": "2.26",
    "baseline_period": 0,
    "target_period": 5,
    "description": "combined revenue[final]/revenue[0] on your own plan's trajectory must be >= target_multiple"
  },
  "parent_constraints": [
    {
      "id": "cash_floor",
      "kind": "parent_series_min",
      "metric": "cash",
      "limit": "0",
      "description": "combined ending cash must stay >= 0 every quarter"
    },
    {
      "id": "margin_floor",
      "kind": "parent_margin_min",
      "limit": "0.63",
      "description": "combined gross margin must stay >= 0.63 every quarter"
    }
  ],
  "unit_constraints": [
    {
      "kind": "unit_headcount_capacity"
    }
  ],
  "notes": "Each unit's headcount must cover customers/customers_per_head; net hires draw the shared headcount pool and add payroll (eroding the margin floor). Growth dollars compound through each unit's customer base at a rate set by its churn, so the optimal split changes over the horizon. Raising quarter-0 marketing raises your own quarter-0 combined revenue (the goal denominator)."
}
