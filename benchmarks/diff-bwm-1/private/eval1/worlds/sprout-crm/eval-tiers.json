{
  "model_id": "sprout-crm",
  "registry_ref": "local:sprout-crm",
  "category": "saas",
  "notes": "Seed-stage SaaS. Naive quadruples marketing and over-hires; careful blends a staged marketing ramp with ~5%/q price rises.",
  "goal": {
    "metric": "revenue",
    "baseline_period": 0,
    "target_period": 5,
    "target_multiple": "3.90",
    "description": "Grow quarterly revenue to at least 3.90x its period-0 value by period 5 while satisfying the tier's constraints."
  },
  "levers": [
    "marketing_spend",
    "hires_per_quarter",
    "acv"
  ],
  "tiers": {
    "soft": {
      "constraints": [
        {
          "id": "burn_ceiling",
          "kind": "series_max",
          "driver": "net_burn",
          "limit": "331008.00",
          "description": "Quarterly net burn must not exceed the ceiling in any quarter."
        },
        {
          "id": "cash_floor",
          "kind": "series_min",
          "driver": "cash",
          "limit": "0",
          "description": "Ending cash must be non-negative every quarter."
        },
        {
          "id": "margin_floor",
          "kind": "series_min",
          "driver": "gross_margin_pct",
          "limit": "0.7700",
          "description": "Gross margin must hold at or above the floor every quarter."
        },
        {
          "id": "hire_cap",
          "kind": "binding_max",
          "driver": "hires_per_quarter",
          "limit": "6",
          "description": "Net hires per quarter (a plan binding) must not exceed the cap."
        }
      ],
      "description": "Naive plans usually work."
    },
    "hard": {
      "constraints": [
        {
          "id": "burn_ceiling",
          "kind": "series_max",
          "driver": "net_burn",
          "limit": "257696.66",
          "description": "Quarterly net burn must not exceed the ceiling in any quarter."
        },
        {
          "id": "cash_floor",
          "kind": "series_min",
          "driver": "cash",
          "limit": "0",
          "description": "Ending cash must be non-negative every quarter."
        },
        {
          "id": "margin_floor",
          "kind": "series_min",
          "driver": "gross_margin_pct",
          "limit": "0.7900",
          "description": "Gross margin must hold at or above the floor every quarter."
        },
        {
          "id": "hire_cap",
          "kind": "binding_max",
          "driver": "hires_per_quarter",
          "limit": "3",
          "description": "Net hires per quarter (a plan binding) must not exceed the cap."
        }
      ],
      "description": "Naive plans sometimes violate."
    },
    "hostile": {
      "constraints": [
        {
          "id": "burn_ceiling",
          "kind": "series_max",
          "driver": "net_burn",
          "limit": "200622.25",
          "description": "Quarterly net burn must not exceed the ceiling in any quarter."
        },
        {
          "id": "cash_floor",
          "kind": "series_min",
          "driver": "cash",
          "limit": "0",
          "description": "Ending cash must be non-negative every quarter."
        },
        {
          "id": "margin_floor",
          "kind": "series_min",
          "driver": "gross_margin_pct",
          "limit": "0.8100",
          "description": "Gross margin must hold at or above the floor every quarter."
        },
        {
          "id": "hire_cap",
          "kind": "binding_max",
          "driver": "hires_per_quarter",
          "limit": "2",
          "description": "Net hires per quarter (a plan binding) must not exceed the cap."
        }
      ],
      "description": "Naive plans are guaranteed to fail; only careful reasoning succeeds."
    }
  }
}
