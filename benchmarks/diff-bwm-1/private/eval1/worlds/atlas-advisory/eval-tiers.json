{
  "model_id": "atlas-advisory",
  "registry_ref": "local:atlas-advisory",
  "category": "services",
  "notes": "Consulting: hires are paid immediately but bill only after a 2-quarter ramp (with 4%/q attrition of the billable pool). Utilization and rate are the efficient levers.",
  "goal": {
    "metric": "revenue",
    "baseline_period": 0,
    "target_period": 5,
    "target_multiple": "1.55",
    "description": "Grow quarterly revenue to at least 1.55x its period-0 value by period 5 while satisfying the tier's constraints."
  },
  "levers": [
    "hires_per_quarter",
    "utilization",
    "rate_per_consultant",
    "bd_spend"
  ],
  "tiers": {
    "soft": {
      "constraints": [
        {
          "id": "burn_ceiling",
          "kind": "series_max",
          "driver": "net_burn",
          "limit": "1782723.20",
          "description": "Quarterly net burn must not exceed the ceiling in any quarter."
        },
        {
          "id": "cash_floor",
          "kind": "series_min",
          "driver": "cash",
          "limit": "0",
          "description": "Ending cash must be non-negative every quarter."
        },
        {
          "id": "margin_floor",
          "kind": "series_min",
          "driver": "gross_margin_pct",
          "limit": "0.7700",
          "description": "Gross margin must hold at or above the floor every quarter."
        },
        {
          "id": "hire_cap",
          "kind": "binding_max",
          "driver": "hires_per_quarter",
          "limit": "15",
          "description": "Net hires per quarter (a plan binding) must not exceed the cap."
        }
      ],
      "description": "Naive plans usually work."
