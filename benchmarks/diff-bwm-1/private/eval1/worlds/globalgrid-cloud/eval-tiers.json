          "kind": "series_min",
          "driver": "cash",
          "limit": "0",
          "description": "Ending cash must be non-negative every quarter."
        },
        {
          "id": "margin_floor",
          "kind": "series_min",
          "driver": "gross_margin_pct",
          "limit": "0.7500",
          "description": "Gross margin must hold at or above the floor every quarter."
        },
        {
          "id": "hire_cap",
          "kind": "binding_max",
          "driver": "hires_per_quarter",
          "limit": "200",
          "description": "Net hires per quarter (a plan binding) must not exceed the cap."
        }
      ],
      "description": "Naive plans sometimes violate."
    },
    "hostile": {
      "constraints": [
        {
          "id": "burn_ceiling",
