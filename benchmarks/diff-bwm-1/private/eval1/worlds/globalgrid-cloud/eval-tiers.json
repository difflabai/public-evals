{
  "model_id": "globalgrid-cloud",
  "registry_ref": "local:globalgrid-cloud",
  "category": "saas",
  "notes": "Public-scale SaaS. Efficiency, not survival: constraints bind on burn discipline at large absolute numbers.",
  "goal": {
    "metric": "revenue",
    "baseline_period": 0,
    "target_period": 5,
    "target_multiple": "1.45",
    "description": "Grow quarterly revenue to at least 1.45x its period-0 value by period 5 while satisfying the tier's constraints."
  },
  "levers": [
    "marketing_spend",
    "hires_per_quarter",
    "acv"
  ],
  "tiers": {
    "soft": {
      "constraints": [
        {
          "id": "burn_ceiling",
          "kind": "series_max",
          "driver": "net_burn",
          "limit": "92103125.00",
          "description": "Quarterly net burn must not exceed the ceiling in any quarter."
        },
        {
          "id": "cash_floor",
          "kind": "series_min",
          "driver": "cash",
          "limit": "0",
          "description": "Ending cash must be non-negative every quarter."
        },
        {
          "id": "margin_floor",
          "kind": "series_min",
          "driver": "gross_margin_pct",
          "limit": "0.7300",
          "description": "Gross margin must hold at or above the floor every quarter."
        },
        {
          "id": "hire_cap",
          "kind": "binding_max",
          "driver": "hires_per_quarter",
          "limit": "450",
          "description": "Net hires per quarter (a plan binding) must not exceed the cap."
        }
      ],
      "description": "Naive plans usually work."
    },
    "hard": {
      "constraints": [
        {
          "id": "burn_ceiling",
          "kind": "series_max",
