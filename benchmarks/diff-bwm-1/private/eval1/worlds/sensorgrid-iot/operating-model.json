      "category": "other"
    },
    {
      "id": "device_revenue",
      "label": "Device revenue",
      "category": "revenue"
    },
    {
      "id": "sub_revenue",
      "label": "Subscription revenue",
      "category": "revenue"
    },
    {
      "id": "marketing_spend",
      "label": "Demand-gen spend",
      "category": "operating_expense"
    },
    {
      "id": "capex",
      "label": "Capex",
      "category": "capex"
    },
    {
      "id": "revenue",
      "label": "Revenue",
      "category": "revenue"
    },
    {
      "id": "cogs",
      "label": "Cost of revenue",
      "category": "cost_of_revenue"
    },
    {
      "id": "gross_margin_pct",
      "label": "Gross margin",
      "category": "other"
    },
    {
      "id": "payroll_cost",
      "label": "Payroll",
      "category": "operating_expense"
    },
    {
      "id": "total_opex",
      "label": "Total OpEx",
      "category": "operating_expense"
    },
    {
      "id": "net_burn",
      "label": "Net burn",
      "category": "other"
    },
    {
      "id": "cash",
      "label": "Cash (ending)",
      "category": "other"
    },
    {
      "id": "headcount",
      "label": "Headcount",
      "category": "other"
    }
  ],
