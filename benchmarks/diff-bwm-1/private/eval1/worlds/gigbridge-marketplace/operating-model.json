    },
    {
      "id": "cash",
      "label": "Cash (ending)",
      "category": "other"
    },
    {
      "id": "headcount",
      "label": "Headcount",
      "category": "other"
    }
  ],
  "created_at": "2026-06-11T00:00:00Z",
