      "label": "Filled jobs",
      "category": "other"
    },
    {
      "id": "fill_rate",
      "label": "Fill rate",
      "category": "other"
    },
    {
      "id": "marketing_spend",
      "label": "Acquisition spend",
      "category": "operating_expense"
    },
    {
      "id": "revenue",
      "label": "Revenue",
      "category": "revenue"
    },
    {
      "id": "cogs",
      "label": "Cost of revenue",
      "category": "cost_of_revenue"
    },
    {
      "id": "gross_margin_pct",
      "label": "Gross margin",
      "category": "other"
    },
    {
      "id": "payroll_cost",
